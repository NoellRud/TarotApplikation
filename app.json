{
  "expo": {
    "name": "Divine Reading",
    "slug": "divine-reading",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/TarotBack5Logo.png",
    "scheme": "tarotapplikation",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets//images/TarotBack5Logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d2818",
        "foregroundImage": "./assets/images/DivineLogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shinal.divinereading"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/TarotBack5Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d2818",
          "image": "./assets/images/TarotBack5Logo.png",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8f55d200-4cb8-4712-9ab0-dc82990cfec1"
      }
    }
  }
}
